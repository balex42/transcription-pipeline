# Dedicated faster-whisper / CTranslate2 recognition image.
#
# This image is intentionally independent of the Transformers ASR stack: it
# installs only its dedicated runtime lock plus the backend-neutral code needed
# to load prepared artifacts, run recognize-prepared, and write ASR artifacts.
# It is not a restoration of the removed Transformers Whisper backend.
#
# CTranslate2 GPU wheels require CUDA 12.x and cuDNN 9 at runtime; the base
# image provides both. The model cache is mounted read-only at /models and the
# model is loaded from the cached snapshot path (HF_HUB_OFFLINE=1).
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

COPY --from=uv /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/cache/home \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/cache \
    XDG_CONFIG_HOME=/cache/config \
    TMPDIR=/cache/tmp \
    WORKING_DIRECTORY=/work

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ffmpeg git git-lfs libnss-wrapper \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app /work /cache/home /cache/config /cache/tmp /models \
    && chgrp -R 0 /work /cache /models \
    && chmod -R g=u /work /cache /models

WORKDIR /app
COPY runtimes/faster-whisper/pyproject.toml runtimes/faster-whisper/uv.lock /runtime/
COPY pyproject.toml README.md LICENSE ./
COPY src ./src

# The runtime lock contains only CTranslate2/faster-whisper dependencies; the
# shared application source is installed separately without its optional extras.
RUN /bin/uv venv --python python3 /app/.venv \
    && /bin/uv export --project /runtime --locked --no-dev --no-emit-project \
        --format requirements-txt --output-file /tmp/requirements.txt \
    && UV_CACHE_DIR=/tmp/uv-cache /bin/uv pip install --python /app/.venv/bin/python \
        --no-deps --require-hashes -r /tmp/requirements.txt \
    && /bin/uv pip install --python /app/.venv/bin/python --no-deps . \
    && rm -rf /tmp/uv-cache /tmp/requirements.txt

# The container runs as an arbitrary non-root UID that is normally a member of
# group 0. The uid-entrypoint resolves the runtime UID/GID through NSS wrapper
# when they have no /etc/passwd or /etc/group entry, so getpwuid() and friends
# work for any Kubernetes/OpenShift-assigned UID without modifying /etc/passwd.
COPY container/uid-entrypoint.sh /usr/local/bin/uid-entrypoint
USER 1001
RUN /usr/local/bin/uid-entrypoint /app/.venv/bin/python -c "import os, pwd; print(pwd.getpwuid(os.getuid()))"
ENTRYPOINT ["/usr/local/bin/uid-entrypoint", "/app/.venv/bin/python", "-m", "speech_transcriber"]
CMD ["--help"]
