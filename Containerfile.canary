# Dedicated NVIDIA NeMo / Canary recognition image.
#
# This runtime is intentionally independent of the generic and faster-whisper
# images. The PyTorch base owns Torch, CUDA, and cuDNN; the runtime lock owns
# the released NeMo ASR stack. Canary is restored from a cached local .nemo
# checkpoint; /models is mounted read-only at runtime.
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM pytorch/pytorch:2.12.0-cuda13.2-cudnn9-runtime

COPY --from=uv /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/cache/home \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/cache \
    XDG_CONFIG_HOME=/cache/config \
    TMPDIR=/cache/tmp \
    WORKING_DIRECTORY=/work \
    VIRTUAL_ENV=/app/.venv \
    PATH=/app/.venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends libnss-wrapper \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app /work /cache/home /cache/config /cache/tmp /models \
    && chgrp -R 0 /work /cache /models \
    && chmod -R g=u /work /cache /models

WORKDIR /app
COPY runtimes/canary/pyproject.toml runtimes/canary/uv.lock /runtime/
COPY pyproject.toml README.md LICENSE ./
COPY src ./src

# Keep the base Torch visible to the isolated runtime. Pruning Torch removes
# its wheel and CUDA-library subtree, so the base image remains their owner.
RUN /bin/uv venv --python python --system-site-packages /app/.venv \
    && /bin/uv export --project /runtime --locked --no-dev --no-emit-project \
        --prune torch --format requirements-txt --output-file /tmp/requirements.txt \
    && UV_CACHE_DIR=/tmp/uv-cache /bin/uv pip install --python /app/.venv/bin/python \
        --no-deps --require-hashes -r /tmp/requirements.txt \
    && /bin/uv pip install --python /app/.venv/bin/python --no-deps . \
    && rm -rf /tmp/uv-cache /tmp/requirements.txt

# The container runs as an arbitrary non-root UID that is normally a member of
# group 0. The uid-entrypoint resolves the runtime UID/GID through NSS wrapper
# when they have no /etc/passwd or /etc/group entry, so getpwuid() and friends
# work for any Kubernetes/OpenShift-assigned UID without modifying /etc/passwd.
# The smoke test runs after USER 1001 through the entrypoint, so it verifies
# the passwd lookup under the non-root identity that NeMo exercises at model
# load time.
COPY container/uid-entrypoint.sh /usr/local/bin/uid-entrypoint
USER 1001
RUN /usr/local/bin/uid-entrypoint /app/.venv/bin/python -c "import os, pwd, nemo, nemo.collections.asr, speech_transcriber, torch; print(pwd.getpwuid(os.getuid())); assert torch.__version__.startswith('2.12.0'); assert torch.version.cuda and torch.version.cuda.startswith('13.2'); print(torch.__version__); print(torch.version.cuda); print(nemo.__version__)"
ENTRYPOINT ["/usr/local/bin/uid-entrypoint", "/app/.venv/bin/python", "-m", "speech_transcriber"]
CMD ["--help"]
