# Dedicated NVIDIA NeMo / Canary recognition image.
#
# This runtime is intentionally independent of the generic Transformers and
# faster-whisper images. The PyTorch base supplies the released CUDA 13.2
# wheel required by NeMo 3.0.0 and supports Blackwell GPUs. Canary is restored
# from a cached local .nemo checkpoint; /models is mounted read-only at runtime.
FROM ghcr.io/astral-sh/uv:0.11.32 AS uv

FROM pytorch/pytorch:2.12.0-cuda13.2-cudnn9-runtime

COPY --from=uv /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/cache/home \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/cache \
    XDG_CONFIG_HOME=/cache/config \
    TMPDIR=/cache/tmp \
    WORKING_DIRECTORY=/work \
    VIRTUAL_ENV=/app/.venv \
    PATH=/app/.venv/bin:$PATH

RUN mkdir -p /app /work /cache/home /cache/config /cache/tmp /models \
    && chgrp -R 0 /work /cache /models \
    && chmod -R g=u /work /cache /models

WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src

# The base's Conda Python already provides torch==2.12.0+cu132. Keep that
# tested CUDA build visible to an isolated app venv rather than replacing it,
# then install the locked NeMo ASR runtime and the project itself.
RUN /bin/uv venv --python python --system-site-packages /app/.venv

RUN /bin/uv export --frozen --no-dev --extra canary-runtime --no-emit-project \
    --format requirements-txt --emit-index-url --output-file /tmp/requirements.txt

RUN UV_CACHE_DIR=/tmp/uv-cache /bin/uv pip install --python /app/.venv/bin/python \
    --require-hashes -r /tmp/requirements.txt

RUN /bin/uv pip install --python /app/.venv/bin/python --no-deps . \
    && rm -rf /tmp/uv-cache /tmp/requirements.txt

# The container runs as an arbitrary non-root UID that is normally a member of group 0.
USER 1001
ENTRYPOINT ["/app/.venv/bin/python", "-m", "speech_transcriber"]
CMD ["--help"]
